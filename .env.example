# ADGRID Cloud — environment template
# Copy to .env and fill in real values. NEVER commit .env itself.

# Auth
JWT_ACCESS_SECRET="change-me-strong-access-secret"
JWT_REFRESH_SECRET="change-me-strong-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# App
# Application URLs (VERCEL_URL is automatically populated on Vercel deployments)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Demo mode: built-in test logins (see server/demoProvisioning.ts).
# true for previews/demos, false in strict production.
DEMO_AUTH_ENABLED="true"

# Supabase PostgreSQL
# DATABASE_URL should be the Supavisor transaction-mode URL (port 6543) for Vercel runtime traffic.
# DIRECT_URL should be the session-mode URL (port 5432) for Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"

# Media storage (drivers: local | cloudinary)
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"
# CLOUDINARY_URL="cloudinary://key:secret@cloud"

# Booking engine
BOOKING_DEPOSIT_PERCENT="50"

# Payment gateways (webhook signature verification)
# PAYSTACK_SECRET_KEY="sk_test_xxx"
# PAYSTACK_WEBHOOK_SECRET="whsec_xxx"
# FLUTTERWAVE_SECRET_KEY="FLW_SECRET_KEY"
# FLUTTERWAVE_WEBHOOK_SECRET="FLWSECK_TEST_xxx"
# STRIPE_SECRET_KEY="sk_test_xxx"

# Email Delivery (Resend API)
# RESEND_API_KEY: Required for real transactional emails (e.g., re_123456789).
# RESEND_FROM_EMAIL: Sender identity verified in your Resend domains dashboard.
# For local-only testing, onboarding@resend.dev works with the Resend account email.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ADGRID Security <onboarding@resend.dev>"
# Override only for local/staging mocks of the Resend API.
# RESEND_API_URL="https://api.resend.com/emails"
# Development-only: expose the last emailed verification code at
# GET /api/auth/dev-last-otp?email=... so signup can be completed without an
# inbox. Ignored entirely when NODE_ENV=production. Set to "false" to disable.
# ALLOW_DEV_EMAIL_INSPECTION="true"

# Local development database (optional)
# Start the embedded Postgres and point Prisma at it, then run the app with the
# pg driver adapter so no native Prisma engine binary is required:
#   npm run dev:db
#   npm run dev:db:migrate
#   PRISMA_DRIVER_ADAPTER="pg"
PRISMA_DRIVER_ADAPTER=""
PRISMA_POOL_MAX="5"

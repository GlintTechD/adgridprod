{
  "name": "ADGRID-cloud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/vite/bin/vite.js build && node ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "vercel-build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/vite/bin/vite.js build",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); try{fs.unlinkSync('server.js')}catch(e){}\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "smoke:auth": "node ./node_modules/tsx/dist/cli.mjs scripts/smoke-auth.ts",
    "smoke:signup": "node scripts/smoke-signup-signin.mjs",
    "smoke:otp": "node ./node_modules/tsx/dist/cli.mjs scripts/smoke-otp-verification.ts",
    "smoke:hierarchy": "node ./node_modules/tsx/dist/cli.mjs scripts/smoke-hierarchy.ts",
    "dev:db": "node ./node_modules/tsx/dist/cli.mjs scripts/dev-postgres.ts",
    "dev:db:migrate": "node scripts/dev-db-migrate.mjs",
    "db:generate:offline": "node scripts/generate-client-offline.mjs",
    "admin:create": "node ./node_modules/tsx/dist/cli.mjs scripts/create-platform-admin.ts",
    "verify:prod": "node scripts/verify-production-config.mjs",
    "mock:resend": "node scripts/mock-resend.mjs"
  },
  "trustedDependencies": [
    "esbuild",
    "prisma"
  ],
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "enhanced-resolve": "^5.25.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otplib": "^12.0.0",
    "prisma": "^5.22.0",
    "qrcode": "^1.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/internals": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.5",
    "@types/cors": "^2.8.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "^8.13.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
